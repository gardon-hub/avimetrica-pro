# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Base de datos local (SQLite) y respaldos — contiene datos de pesajes reales.
# Crear con: npx prisma db push
/db/*.db
/db/*.db-journal
/db/*.backup*
/db/*backup*

# Guías genéticas y material de origen (PDFs con derechos de autor de las
# casas genéticas, e imágenes derivadas). Se conservan solo en local: las
# tablas ya extraídas viven en src/lib/ y su procedencia en src/lib/fuentes.ts
/upload/
/download/
/examples/
/mini-services/
/.zscripts//db/*.json
